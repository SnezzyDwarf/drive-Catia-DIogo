{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

  "crons": [
    {
      "path": "/api/cron/sync-photos",
      "schedule": "0 4 * * *"
    }
  ]
}